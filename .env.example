# --- server ---
# Sign-in password. Either plain APP_PASSWORD, or APP_PASSWORD_HASH from:
#   node src/server/hash-password.ts 'your password'
APP_PASSWORD=change-me
APP_PASSWORD_HASH=
# Shared secret between server and worker. Any long random string: openssl rand -hex 32
WORKER_TOKEN=
# Fine-grained GitHub PAT: Contents (read/write) + Pull requests (read/write) + Checks (read) on your repos.
# Used by the server (PR sync, merge) and the worker (clone, push, gh pr create).
GITHUB_TOKEN=
# Where you open the app. Use https:// when it is behind TLS (secure cookies).
PUBLIC_URL=http://localhost:3000
VAPID_SUBJECT=mailto:you@example.com
MAX_CONCURRENT_SESSIONS=3

# --- worker ---
# Your Claude subscription: run `claude setup-token` on your own machine and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or bill to the API instead (leave the OAuth token empty):
ANTHROPIC_API_KEY=
GIT_AUTHOR_NAME=Dispatch Agent
GIT_AUTHOR_EMAIL=dispatch@localhost
# Optional model override, e.g. claude-opus-5-5. Empty = Claude Code default.
AGENT_MODEL=
# fake = scripted runner, no Claude usage (for trying the UI)
RUNNER=claude
# Assistant chat (manages projects/repos/items for you). Model alias or id.
ASSISTANT_MODEL=haiku
# "Discuss this" chats on items (read-only). Defaults to ASSISTANT_MODEL.
DISCUSS_MODEL=haiku
# Folders the assistant may read, ':'-separated. In Docker, mount them read-only (see compose.yml).
ASSISTANT_READ_DIRS=/host/projects
# Host folder mounted read-only for the assistant in Docker
ASSISTANT_HOST_DIR=./
# Local-only repos (no GitHub): folders that may hold them, ':'-separated. Agents push their
# branches into these repos and merges update their default branch. Off when empty.
# In Docker, mount them read-write (see compose.yml).
LOCAL_REPO_DIRS=

# --- accounts (optional; without them GITHUB_TOKEN / the Claude login above form one "default" account) ---
# GitHub accounts: a project picks one; its repos clone/push/merge with it and commits use its identity.
# Needed by the server (PR sync, merge) and the worker (git, gh).
#GITHUB_ACCOUNTS=personal,work
#GITHUB_ACCOUNT_PERSONAL_TOKEN=
#GITHUB_ACCOUNT_WORK_TOKEN=
#GITHUB_ACCOUNT_WORK_GIT_NAME=
#GITHUB_ACCOUNT_WORK_GIT_EMAIL=
# Claude accounts (worker only): a project has a default and an allowed list; a batch can override.
# SSO accounts: log in once with   CLAUDE_CONFIG_DIR=~/.claude-dispatch/work claude   then /login
#CLAUDE_ACCOUNTS=private,work
#CLAUDE_ACCOUNT_PRIVATE_CONFIG_DIR=~/.claude
#CLAUDE_ACCOUNT_WORK_CONFIG_DIR=~/.claude-dispatch/work
#CLAUDE_ACCOUNT_WORK_LABEL=Work
#   or per account: CLAUDE_ACCOUNT_X_OAUTH_TOKEN= (claude setup-token)  /  CLAUDE_ACCOUNT_X_API_KEY=

# Worker tools. Folders put first on agents' PATH (e.g. a Go install), separated by ':'.
#AGENT_EXTRA_PATH=~/.local/go/bin
# Under WSL the worker adds Windows' own PATH, so agents can run powershell.exe (PowerPoint) and
# other Windows tools as from a Windows terminal. Set to off to keep Windows out of reach.
#WINDOWS_PATH=off

# Sign-in: password (default), or proxy behind a sign-in proxy (SSO forward-auth).
#AUTH_MODE=proxy
#TRUSTED_PROXIES=192.0.2.10            # the proxy's address(es); IPs or IPv4 CIDRs, comma separated
#AUTH_USERS=alice                      # users allowed in; empty = whoever the proxy lets through
#AUTH_HEADER=Remote-User
# Recommended behind a proxy: a secret it adds to every request (e.g. Traefik headers.customRequestHeaders),
# so other programs on the proxy's host (same address) cannot pose as it. At least 24 characters.
#PROXY_SECRET=
#PROXY_SECRET_HEADER=X-Proxy-Secret
# Scopes a token gets when used from another machine (default read,tracker)
#TOKEN_REMOTE_SCOPES=read,tracker
