# Dispatch server. Copy to server.env (next to compose.yml) and fill in. Not in git.
# Any secret can come from a file instead: NAME_FILE=/run/secrets/name.

# The worker "default" connects with this. Make one with: openssl rand -hex 32
# Put the SAME value in worker.env. (Workers on other machines get their own tokens in Settings → Workers.)
WORKER_TOKEN=

# Sign-in password for the app (or APP_PASSWORD_HASH from: node src/server/hash-password.ts 'pw')
APP_PASSWORD=change-me

# The address you open the app on. https:// when it is behind TLS.
PUBLIC_URL=http://localhost:3000

# GitHub: the server follows PRs and merges them. Fine-grained token: Contents rw, Pull requests rw,
# Checks read, on your repos. Optional (without it there is no PR sync or merge).
GITHUB_TOKEN=

# Who sends the push notifications (any mailto: of yours)
VAPID_SUBJECT=mailto:you@example.com

# Behind a sign-in proxy (SSO) instead of the password: see README → "Sign-in behind a proxy".
#AUTH_MODE=proxy
#TRUSTED_PROXIES=192.0.2.10
#AUTH_USERS=alice
#PROXY_SECRET=
