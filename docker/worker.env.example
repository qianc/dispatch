# Dispatch worker. Copy to worker.env (next to compose.yml / compose.worker.yml) and fill in. Not in git.
# Agents run with this environment, so it holds only what the worker needs.

# On the same machine as the server: the WORKER_TOKEN from server.env, and leave SERVER_WS_URL as set
# in compose.yml. On another machine: the dsw_… token from Settings → Workers, and the server address:
WORKER_TOKEN=
#SERVER_WS_URL=wss://dispatch.example.com/worker

# Claude: run `claude setup-token` on your own computer and paste the token here (uses your subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# …or bill the API instead:
#ANTHROPIC_API_KEY=

# GitHub: clone, push, open PRs (same kind of token as the server's)
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Dispatch Agent
GIT_AUTHOR_EMAIL=dispatch@example.com
GIT_COMMITTER_NAME=Dispatch Agent
GIT_COMMITTER_EMAIL=dispatch@example.com

# Agent sessions at once on this worker
MAX_CONCURRENT_SESSIONS=3

# Try the app without using Claude: a scripted fake agent
#RUNNER=fake

# Optional: models (empty = Claude Code default), and the cheaper model for chats
#AGENT_MODEL=
ASSISTANT_MODEL=haiku
DISCUSS_MODEL=haiku

# Several Claude or GitHub accounts, local repos, a worker for several servers: see .env.example and
# README → "Configuration".
